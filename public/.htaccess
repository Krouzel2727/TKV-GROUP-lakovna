# ============================================================
#  .htaccess pro hosting s Apache (nahraje se spolu s webem)
# ============================================================

# --- Jedna hlavní adresa: https://www.tkvgrouplakovna.cz ---
# Přesměruje http:// a adresu bez www (301 = trvalé přesměrování, předá SEO hodnocení).
# Pozn.: pokud by po nahrání vznikla smyčka přesměrování (hosting za proxy/CDN),
#        zakomentujte první RewriteCond s HTTPS a ponechte jen podmínku na X-Forwarded-Proto.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.tkvgrouplakovna.cz%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.tkvgrouplakovna.cz%{REQUEST_URI} [L,R=301]

  # /index.html → / (jedna adresa pro úvodní stránku)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

DirectoryIndex index.html
ErrorDocument 404 /index.html

# --- Komprese ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# --- Typy souborů ---
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# --- Cache ---
<IfModule mod_headers.c>
  # Soubory v /assets mají v názvu otisk obsahu → lze je cachovat napořád
  <FilesMatch "^.+-[A-Za-z0-9_-]{8}\.(js|css|webp|avif|png|jpe?g|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML vždy ověřit, aby se změny webu projevily hned
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # --- Bezpečnostní hlavičky ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
